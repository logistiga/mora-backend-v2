# Used by e2e tests (test/*.e2e-spec.ts). Not a secret — dummy values only.
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Reuses the same role as docker-compose's mora-postgres (.env.example
# defaults: mora/changeme) but a separate database, so e2e tests can run
# against the same local compose stack without a second Postgres role.
POSTGRES_USER=mora
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mora_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mora:changeme@localhost:5432/mora_test?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# No LLM provider in tests by default — LlmService's "not configured" path is
# itself covered by a test. Individual e2e tests can override the provider
# via DI (see test/messages.e2e-spec.ts) to exercise the "mocked" path.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
MORA_CROSS_SCOPE_ENABLED=false
