# Copy to .env.staging on the staging host and fill in real values.
# Never commit the real .env.staging.

# ---- Routing (used by docker-compose.staging.yml) ----
STAGING_HOST=mora-v2-staging.logistiga.tech

# ---- App ----
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# Comma-separated. An entry containing `*` matches one subdomain label.
CORS_ORIGIN=https://mora-v2-staging.logistiga.tech,https://*.lovable.app,https://*.lovableproject.com,http://localhost:5173,http://localhost:3000
# Staging keeps Swagger on even though NODE_ENV=production.
MORA_SWAGGER_ENABLED=true

# ---- Database (staging-only instance) ----
POSTGRES_USER=mora_staging
POSTGRES_PASSWORD=
POSTGRES_DB=mora_staging
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mora_staging:@postgres:5432/mora_staging?schema=public

# ---- Redis (staging-only instance) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth (generate with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- AI providers ----
# Runtime providers are managed through /api/v1/ai-providers (encrypted at
# rest with MORA_ENCRYPTION_KEY). Generate with: openssl rand -base64 32
MORA_ENCRYPTION_KEY=
OPENAI_API_KEY=
MORA_EMBEDDING_ENABLED=false

# ---- Misc ----
MORA_CROSS_SCOPE_ENABLED=false
MORA_DEFAULT_TIMEZONE=Africa/Tunis
MORA_DOCUMENTS_STORAGE_DIR=/app/storage/documents
MORA_WHATSAPP_WEBHOOK_SECRET=
