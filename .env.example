# Copy to .env for local development. Never commit the real .env.
# See src/config/env.validation.ts for the full list of validated variables.

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
POSTGRES_USER=mora
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mora:changeme@localhost:5432/mora?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Logical Redis DB (0-15). Keep dev on 0; tests use a different one (.env.test)
# so a running dev server and the e2e suite never fight over the same BullMQ
# queues in the same Redis instance.
REDIS_DB=0

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- LLM (Phase B) ----
# Leave OPENAI_API_KEY unset to run with no LLM provider configured — the app
# starts fine and LlmService returns an explicit "not configured" response.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Router / cross-scope security ----
# Personal and Professional stay isolated by default. Hybrid requests are
# degraded (not answered normally) unless this is explicitly set to true.
MORA_CROSS_SCOPE_ENABLED=false

# ---- Embeddings (Phase C) ----
# Leave MORA_EMBEDDING_ENABLED=false (or MORA_EMBEDDING_API_KEY unset) to run
# with no embedding provider — the app starts fine, memories are stored
# without a vector, and MemoryRetrievalService uses the text fallback.
MORA_EMBEDDING_ENABLED=false
MORA_EMBEDDING_PROVIDER=openai-compatible
MORA_EMBEDDING_BASE_URL=https://api.openai.com/v1
MORA_EMBEDDING_API_KEY=
MORA_EMBEDDING_MODEL=text-embedding-3-small

# ---- Memory tuning (Phase C) ----
MORA_MEMORY_RETRIEVAL_LIMIT=8
MORA_CONTEXT_BUDGET_CHARS=6000
MORA_SUMMARY_MESSAGE_THRESHOLD=20
