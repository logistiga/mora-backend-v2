# Copy to .env for local development. Never commit the real .env.
# See src/config/env.validation.ts for the full list of validated variables.

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
POSTGRES_USER=mora
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mora
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mora:changeme@localhost:5432/mora?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- LLM (Phase B) ----
# Leave OPENAI_API_KEY unset to run with no LLM provider configured — the app
# starts fine and LlmService returns an explicit "not configured" response.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Router / cross-scope security ----
# Personal and Professional stay isolated by default. Hybrid requests are
# degraded (not answered normally) unless this is explicitly set to true.
MORA_CROSS_SCOPE_ENABLED=false
