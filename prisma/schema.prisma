// Mora Backend v2 — Prisma schema
// Phase A: core foundation (User + auth).
// Phase B: router/agents/orchestrator plumbing (Conversation, Message,
// RouterDecision, AuditEntry, Setting).
// Phase C: intelligent memory (Memory, Entity, MemoryEntity,
// ConversationSummary, ProfileFact) — see docs/ARCHITECTURE.md for the
// retrieval/embedding/extraction design.
// Phase C.5: AI provider manager (AiProvider, LlmCall) — multi-LLM/embedding
// providers with encrypted API keys. See docs/ARCHITECTURE.md.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (for migrate/studio) and
  // is passed to PrismaClient via a driver adapter at runtime (see prisma.service.ts).
  // pgvector is enabled at the database level via docker/postgres/init-pgvector.sql
  // (CREATE EXTENSION IF NOT EXISTS vector). Declaring it here keeps `prisma migrate`
  // aware of the extension so future `vector` columns (Phase C) don't require a manual
  // migration edit.
  extensions = [vector]
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  refreshTokens  RefreshToken[]
  conversations  Conversation[]
  memories       Memory[]
  entities       Entity[]
  profileFacts   ProfileFact[]
  aiProviders    AiProvider[]
  tasks          Task[]
  reminders      Reminder[]
  notifications  Notification[]
  pendingActions PendingAction[]
  toolCalls      ToolCall[]
  documents      Document[]
  contacts       Contact[]
  contactIdentities ContactIdentity[]
  whatsAppAccounts  WhatsAppAccount[]
  emailAccounts     EmailAccount[]
  calendarEvents    CalendarEvent[]
  voiceSessions     VoiceSession[]
  voiceProfiles     VoiceProfile[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// One row per issued refresh token (hashed, never stored in plaintext) so a token
// can be revoked / rotated individually instead of invalidating every session.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// route/scope/space/intent/complexity/securityLevel are kept as plain strings
// (validated in the app layer — see src/router/router.types.ts) rather than DB
// enums, so new professional "spaces" can be added without a migration.
model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  messages        Message[]
  routerDecisions RouterDecision[]
  summaries       ConversationSummary[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     MessageRole
  content  String
  scope    String // 'direct' | 'personal' | 'professional' | 'hybrid'
  space    String // 'direct' | 'personal' | 'general' | 'logistiga' | 'piston' | 'code' | 'hybrid'
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

// One row per routing decision the MoraRouterService made for a given user
// message — kept even if the message/conversation is later removed, since
// this is itself an audit trail of routing behavior.
model RouterDecision {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?      @map("message_id") @db.Uuid

  route         String
  scope         String
  space         String
  intent        String
  complexity    String
  securityLevel String @map("security_level")
  confidence    Float
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("router_decisions")
}

model AuditEntry {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid

  action   String
  scope    String?
  space    String?
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([conversationId])
  @@map("audit_entries")
}

model Setting {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================================
// Phase C — Intelligent memory
// scope/space/kind/status kept as plain strings (validated in the app layer,
// see src/memory/memory.types.ts) for the same reason as Message/RouterDecision
// in Phase B: new kinds/spaces should never require a migration.
//
// `embedding` is declared `Unsupported("vector")` because Prisma Client has no
// native vector scalar: it is written/read exclusively through parameterized
// raw SQL (see src/memory/memory-embedding.repository.ts), never through the
// generated Prisma Client API, and is therefore invisible to `prisma.memory.*`
// calls (create/update/select simply skip it).
//
// No fixed dimension is declared on the column (per the brief: never assume
// 1536), which means an ANN index (HNSW/IVFFlat) is NOT technically
// compatible here — pgvector's own engine rejects `CREATE INDEX ... USING
// hnsw` on a dimensionless `vector` column ("column does not have
// dimensions"), confirmed against a real Postgres+pgvector instance while
// building this phase. Retrieval therefore does an exact (brute-force)
// cosine-distance scan filtered by userId/scope/space/embeddingDimensions —
// correct and fine at Phase C's data volume. Once a production embedding
// model is locked in, a follow-up migration can narrow the column to
// `vector(N)` and add the HNSW index for that fixed N.
// ============================================================================

model Memory {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String // 'personal' | 'general' | 'logistiga' | 'piston' | 'code'
  kind  String // fact|preference|person|company|decision|procedure|event|project|habit

  content    String
  importance Float  @default(0.5)
  confidence Float  @default(0.5)

  source   String // 'manual' | 'extraction'
  sourceId String? @map("source_id") @db.Uuid // e.g. the message this was extracted from

  status     String    @default("active") // active|pending|archived|superseded
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  lastAccessedAt DateTime? @map("last_accessed_at")
  accessCount    Int       @default(0) @map("access_count")

  supersededById String?  @unique @map("superseded_by_id") @db.Uuid
  supersededBy   Memory?  @relation("MemorySupersession", fields: [supersededById], references: [id])
  supersedes     Memory?  @relation("MemorySupersession")

  embedding           Unsupported("vector")?
  embeddingModel       String? @map("embedding_model")
  embeddingDimensions  Int?    @map("embedding_dimensions")

  metadata Json?

  memoryEntities MemoryEntity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@index([userId, status, kind])
  @@map("memories")
}

model Entity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String
  type  String // person|company|client|project|place|equipment|object
  name  String

  aliases  String[] @default([])
  metadata Json?

  memoryEntities   MemoryEntity[]
  documentEntities DocumentEntity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cheap dedup: same user+scope+space+type+name is the same entity.
  @@unique([userId, scope, space, type, name])
  @@index([userId, scope, space])
  @@map("entities")
}

model MemoryEntity {
  id String @id @default(uuid()) @db.Uuid

  memoryId String @map("memory_id") @db.Uuid
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  role String? // e.g. 'subject' | 'mentioned'

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memoryId, entityId])
  @@index([entityId])
  @@map("memory_entities")
}

// One row per (conversation, scope, space) — a conversation can carry both
// personal and professional messages over time (Phase B), so its summary
// must stay split the same way memory/context retrieval does, or a
// personal-scope summary could leak professional content into an agent's
// context and vice versa.
model ConversationSummary {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid

  scope String
  space String

  summary          String
  fromMessageId    String? @map("from_message_id") @db.Uuid
  toMessageId      String? @map("to_message_id") @db.Uuid
  messageCount     Int     @default(0) @map("message_count")
  approxTokenCount Int     @default(0) @map("approx_token_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([conversationId, scope, space])
  @@index([userId])
  @@map("conversation_summaries")
}

model ProfileFact {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String
  space String
  key   String
  value String

  confidence Float  @default(0.5)
  source     String

  status     String    @default("active") // active|archived|superseded
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  supersededById String?      @unique @map("superseded_by_id") @db.Uuid
  supersededBy   ProfileFact? @relation("ProfileFactSupersession", fields: [supersededById], references: [id])
  supersedes     ProfileFact? @relation("ProfileFactSupersession")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@map("profile_facts")
}

// ============================================================================
// Phase C.5 — AI Provider Manager
// `provider` and `kind` are free strings, not enums, so new providers
// (Anthropic, Gemini, Groq, ...) or usage kinds (vision, stt, tts, ...) never
// need a migration — validated in the app layer (see src/ai-providers/).
//
// The API key is never stored in plaintext: `apiKeyEncrypted`/`apiKeyIv`/
// `apiKeyAuthTag` hold an AES-256-GCM ciphertext (see SecretEncryptionService)
// and only `apiKeyHint` (last 4 chars) is safe to ever return from the API.
// ============================================================================

model AiProvider {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String // display name, e.g. "My OpenAI"
  provider String // openai | anthropic | groq | deepseek | gemini | mistral | openrouter | ollama | custom_openai_compatible | ...
  kind     String // chat | embedding | vision | stt | tts | image | avatar | ...
  baseUrl  String? @map("base_url")
  model    String

  // Encrypted secret (all three null together when the provider needs no key,
  // e.g. a local Ollama endpoint with no auth).
  apiKeyEncrypted   String? @map("api_key_encrypted")
  apiKeyIv          String? @map("api_key_iv")
  apiKeyAuthTag     String? @map("api_key_auth_tag")
  apiKeyHint        String? @map("api_key_hint") // last 4 chars only, never the full key
  encryptionVersion Int     @default(1) @map("encryption_version")

  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  // Optional scoping: a global (null/null) provider is the fallback for any
  // scope/space of this kind; a scoped one (e.g. professional/logistiga) is
  // preferred by AiModelSelectorService when it matches exactly.
  scope String?
  space String?

  capabilities Json? // e.g. { chat:true, tools:true, streaming:true, vision:true, jsonMode:true }
  settings     Json? // e.g. { maxTokens, timeoutMs, maxConcurrency }
  priority     Int   @default(0) // higher wins among otherwise-equal candidates

  lastTestedAt   DateTime? @map("last_tested_at")
  lastTestStatus String?   @map("last_test_status") // 'success' | 'failure'
  lastTestMessage String?  @map("last_test_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, isActive])
  @@map("ai_providers")
}

// One row per LLM/embedding call attempted through the provider system —
// observability only. Never stores the API key, the raw prompt, or the raw
// completion (see AiProviderService / LlmService for what's logged instead).
model LlmCall {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  providerId String? @map("provider_id") @db.Uuid

  kind  String
  model String
  route String?
  scope String?
  space String?

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  latencyMs    Int    @map("latency_ms")
  status       String // 'success' | 'error'
  errorCode    String? @map("error_code")
  costEstimate Float?  @map("cost_estimate")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([providerId])
  @@map("llm_calls")
}

// ============================================================================
// Phase D — Tools, actions, permissions, confirmations, tasks, reminders
//
// status/securityLevel/source kept as plain strings (validated in the app
// layer, see src/tools/tool.types.ts) for the same reason as elsewhere in
// this schema: new tools/security levels should never require a migration.
//
// Idempotence design: PendingAction.idempotencyKey is unique and generated
// once when the pending action is created. Approval is a single atomic
// conditional UPDATE (`status = 'pending' -> 'executing'`, see
// PendingActionService.approve) — a second concurrent approval finds 0 rows
// affected and returns the already-in-flight/executed state instead of
// re-running the tool. This is the real safety net against double
// confirmation, not a hash of the input (two identical user requests are
// legitimately two different pending actions / two different tasks).
// ============================================================================

model Task {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String

  title       String
  description String?
  status      String @default("pending") // pending|in_progress|completed|cancelled
  priority    String @default("normal") // low|normal|high|urgent

  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")

  source                String  @default("manual") // manual|tool
  sourceConversationId  String? @map("source_conversation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@map("tasks")
}

model Reminder {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String
  space String

  title    String
  message  String?
  remindAt DateTime @map("remind_at")

  status String @default("scheduled") // scheduled|delivered|cancelled|failed

  source                String  @default("manual") // manual|tool
  sourceConversationId  String? @map("source_conversation_id") @db.Uuid
  bullJobId             String? @map("bull_job_id")

  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@map("reminders")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // e.g. 'reminder'
  title    String
  message  String
  status   String  @default("unread") // unread|read
  metadata Json?

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("notifications")
}

model PendingAction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String? @map("conversation_id") @db.Uuid

  toolName      String @map("tool_name")
  toolVersion   String @map("tool_version")
  scope         String
  space         String
  securityLevel String @map("security_level") // N2 | N3 (N1 never creates a pending action, N4 is never created)

  input  Json
  result Json?
  status String @default("pending") // pending|approved|rejected|executed|expired|cancelled|failed

  idempotencyKey String @unique @map("idempotency_key")

  expiresAt  DateTime? @map("expires_at")
  approvedAt DateTime? @map("approved_at")
  rejectedAt DateTime? @map("rejected_at")
  executedAt DateTime? @map("executed_at")

  toolCalls ToolCall[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("pending_actions")
}

// One row per tool execution attempt — observability + audit for the whole
// Tools/Actions system, mirroring what LlmCall does for raw LLM calls.
// Never stores a secret; `input`/`output` hold only validated tool
// arguments/results, never raw provider payloads or credentials.
model ToolCall {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId  String? @map("conversation_id") @db.Uuid
  pendingActionId String? @map("pending_action_id") @db.Uuid
  pendingAction   PendingAction? @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)

  toolName      String @map("tool_name")
  toolVersion   String @map("tool_version")
  scope         String
  space         String
  securityLevel String @map("security_level")

  input          Json
  output         Json?
  status         String // requested|pending_confirmation|executing|success|failed|rejected|cancelled
  errorCode      String? @map("error_code")
  latencyMs      Int?    @map("latency_ms")
  idempotencyKey String? @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId])
  @@index([pendingActionId])
  @@map("tool_calls")
}

// ============================================================================
// Phase E — Connections + Document Intelligence
//
// Design decisions (documented per AGENTS Phase E §1/§13/§15):
//
// - Classification and summary are single-per-document (Document.documentType/
//   title/language/classificationConfidence/summary/keyPoints) rather than
//   separate `document_classifications`/`document_summaries` tables: Phase E
//   never needs classification/summary history, and a real history
//   requirement can add a table later without touching this one.
// - `Tag` is a small, global, normalized controlled vocabulary (name is
//   unique) — isolation lives in `DocumentTag`/its `Document`, not in `Tag`
//   itself, the same way `Entity` already works per-user. This is what keeps
//   tag explosion under control across users (AGENTS §7): "facture" is one
//   row, not one per user.
// - `DocumentEntity` links to the EXISTING `Entity` model (Phase C) instead
//   of a parallel entity system (AGENTS §8).
// - `DocumentTable` + `DocumentTableRow` (a real rows table, not one giant
//   JSON blob) so a large spreadsheet/table stays queryable and paginable
//   (AGENTS §15).
// - pgvector/HNSW strategy (AGENTS §13): `DocumentChunk.embedding` stays the
//   same dimensionless `Unsupported("vector")` brute-force column Memory
//   already uses (multi-provider flexibility preserved — never broken).
//   ADDITIONALLY, `embeddingVector1536` is a real fixed-dimension `vector(1536)`
//   column, populated only when the embedding actually has 1536 dimensions
//   (today's real provider, text-embedding-3-small) with a genuine HNSW
//   index (added via raw SQL in this migration — see migration.sql). Phase
//   E's retrieval path uses the HNSW-indexed column when the active
//   embedding provider is 1536-dimensional (the common, real case) and
//   falls back to the Phase C brute-force scan otherwise — real ANN
//   performance now, without hardcoding 1536 as the only supported
//   dimension anywhere in application code (AiModelSelectorService/
//   EmbeddingService remain fully multi-provider).
// - Connector health (AGENTS §51) is computed on demand from each
//   connector's own state (e.g. `WhatsAppAccount.status`/`lastSyncAt`/
//   `lastError`), not a separate stored table — avoids an always-stale
//   duplicate of state that already lives on the account/thread rows.
// ============================================================================

model Document {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String

  filename         String
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  extension        String
  sizeBytes        Int    @map("size_bytes")

  documentType String? @map("document_type") // e.g. invoice|contract|report|other — AI-suggested, never security-relevant
  title        String?
  language     String?

  source   String  @default("upload") // 'upload' | 'whatsapp' | 'email'
  sourceId String? @map("source_id") // e.g. the WhatsAppMessage/EmailMessage id, when source != 'upload'

  storageProvider String @map("storage_provider") // 'local' today; 's3'/'minio' ready later
  storageKey      String @map("storage_key")

  status String @default("uploaded") // uploaded|queued|processing|ready|needs_review|failed|archived

  classificationConfidence Float?  @map("classification_confidence")
  needsReview              Boolean @default(false) @map("needs_review")

  summary   String?
  keyPoints Json?   @map("key_points")

  checksum     String // SHA-256 hex, for dedup
  errorMessage String? @map("error_message")

  chunks    DocumentChunk[]
  docTags   DocumentTag[]
  docEntities DocumentEntity[]
  tables    DocumentTable[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")

  @@index([userId, scope, space, status])
  @@index([checksum])
  @@index([source, sourceId])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int     @map("chunk_index")
  page       Int?
  section    String?
  content    String

  tokenCount Int? @map("token_count")

  // See the Phase E design note above: dimensionless brute-force column
  // (any provider/dimension) plus a real fixed-dimension HNSW-indexed
  // column populated only for 1536-dim embeddings (today's real provider).
  embedding           Unsupported("vector")?
  embeddingVector1536  Unsupported("vector(1536)")? @map("embedding_vector_1536")
  embeddingModel       String? @map("embedding_model")
  embeddingDimensions  Int?    @map("embedding_dimensions")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique // normalized: lowercase, trimmed, spaces collapsed — see TagNormalizationService

  documentTags DocumentTag[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tags")
}

model DocumentTag {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id") @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  source     String  @default("manual") // 'manual' | 'ai'
  confidence Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, tagId])
  @@index([tagId])
  @@map("document_tags")
}

// Reuses the existing Phase C `Entity` model rather than a parallel entity
// system (AGENTS Phase E §8).
model DocumentEntity {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityId   String   @map("entity_id") @db.Uuid
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  role String? // e.g. 'subject' | 'mentioned' | 'client' | 'supplier'

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, entityId])
  @@index([entityId])
  @@map("document_entities")
}

model DocumentTable {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sheetName  String? @map("sheet_name")
  tableIndex Int     @map("table_index")
  title      String?

  columns     Json // [{ name, type }]
  rowCount    Int  @map("row_count")
  columnCount Int  @map("column_count")
  metadata    Json?

  rows DocumentTableRow[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_tables")
}

// A real rows table (not one giant JSON blob) so a large spreadsheet stays
// queryable/paginable (AGENTS Phase E §15) — the analytical query layer
// (DocumentTableQueryService) reads a bounded page of rows, never "all rows
// into the LLM".
model DocumentTableRow {
  id      String        @id @default(uuid()) @db.Uuid
  tableId String        @map("table_id") @db.Uuid
  table   DocumentTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  rowIndex Int  @map("row_index")
  data     Json // { columnName: value }

  @@index([tableId, rowIndex])
  @@map("document_table_rows")
}

// ============================================================================
// Phase E — Contacts / Identity
// ============================================================================

model Contact {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  company   String?
  jobTitle  String? @map("job_title")

  scope String
  space String

  relationship String?
  trustLevel   String  @default("unknown") @map("trust_level") // unknown|known|trusted|vip|restricted|blocked

  notes String?
  tags  String[] @default([])

  identities ContactIdentity[]

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastInteractionAt  DateTime? @map("last_interaction_at")

  @@index([userId, scope, space])
  @@map("contacts")
}

model ContactIdentity {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type            String // 'whatsapp' | 'email'
  valueNormalized String @map("value_normalized") // e.g. E.164 phone, lowercased email
  displayValue    String @map("display_value")
  verified        Boolean @default(false)
  metadata        Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Per-user dedup: the same WhatsApp number/email can't be attached to two
  // different contacts of the same user (AGENTS §22).
  @@unique([userId, type, valueNormalized])
  @@index([contactId])
  @@map("contact_identities")
}

// ============================================================================
// Phase E — WhatsApp (Mora's own number, never the user's personal WhatsApp)
// ============================================================================

model WhatsAppAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String
  phoneNumber String  @map("phone_number")
  provider    String // 'evolution' | 'meta_cloud'

  // AES-256-GCM, same pattern as AiProvider (SecretEncryptionService) —
  // never stored/returned in plaintext.
  credentialsEncrypted String? @map("credentials_encrypted")
  credentialsIv        String? @map("credentials_iv")
  credentialsAuthTag   String? @map("credentials_auth_tag")

  status       String    @default("configured") // configured|connected|disconnected|error
  lastSyncAt   DateTime? @map("last_sync_at")
  lastError    String?   @map("last_error") // sanitized only — never a raw provider payload

  autoReplyPolicy Json? @map("auto_reply_policy")

  conversations WhatsAppConversation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("whatsapp_accounts")
}

model WhatsAppConversation {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  account   WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?         @map("contact_id") @db.Uuid

  scope String
  space String

  lastMessageAt DateTime? @map("last_message_at")

  messages WhatsAppMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([contactId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  providerMessageId String @unique @map("provider_message_id") // dedup key (AGENTS §26)
  direction         String // 'inbound' | 'outbound'
  contactId         String? @map("contact_id") @db.Uuid

  timestamp DateTime
  status    String? // sent|delivered|read|failed, when the provider reports it
  text      String?
  metadata  Json?

  attachments WhatsAppAttachment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("whatsapp_messages")
}

model WhatsAppAttachment {
  id         String          @id @default(uuid()) @db.Uuid
  messageId  String          @map("message_id") @db.Uuid
  message    WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String?         @map("document_id") @db.Uuid

  filename  String
  mimeType  String  @map("mime_type")
  sizeBytes Int?    @map("size_bytes")
  storageKey String? @map("storage_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("whatsapp_attachments")
}

// ============================================================================
// Phase E — Email (Mora's own mailbox(es), never an implicit read of the
// user's personal inbox)
// ============================================================================

model EmailAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label    String
  address  String
  provider String // 'imap_smtp' | 'gmail' | 'microsoft_graph'

  imapHost String? @map("imap_host")
  imapPort Int?    @map("imap_port")
  smtpHost String? @map("smtp_host")
  smtpPort Int?    @map("smtp_port")

  credentialsEncrypted String? @map("credentials_encrypted")
  credentialsIv        String? @map("credentials_iv")
  credentialsAuthTag   String? @map("credentials_auth_tag")

  status     String    @default("configured")
  lastSyncAt DateTime? @map("last_sync_at")
  lastError  String?   @map("last_error")

  threads EmailThread[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("email_accounts")
}

model EmailThread {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subject   String?
  scope     String
  space     String
  contactId String? @map("contact_id") @db.Uuid

  lastMessageAt DateTime? @map("last_message_at")

  messages EmailMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId])
  @@map("email_threads")
}

model EmailMessage {
  id       String      @id @default(uuid()) @db.Uuid
  threadId String      @map("thread_id") @db.Uuid
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerMessageId String  @unique @map("provider_message_id")
  from              String
  to                String[]
  cc                String[] @default([])
  subject           String?

  textBody           String? @map("text_body")
  htmlBodySanitized  String? @map("html_body_sanitized") // sanitized at ingest — never raw untrusted HTML (AGENTS §38)

  direction  String // 'inbound' | 'outbound'
  receivedAt DateTime? @map("received_at")
  sentAt     DateTime? @map("sent_at")
  contactId  String?   @map("contact_id") @db.Uuid

  metadata Json?

  attachments EmailAttachment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId])
  @@map("email_messages")
}

model EmailAttachment {
  id         String       @id @default(uuid()) @db.Uuid
  messageId  String       @map("message_id") @db.Uuid
  message    EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String?      @map("document_id") @db.Uuid

  filename   String
  mimeType   String  @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")
  storageKey String? @map("storage_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("email_attachments")
}

// ============================================================================
// Phase E — Calendar (Mora's own internal calendar; Google/Microsoft are
// architecture-ready interfaces, not implemented without real credentials)
// ============================================================================

model CalendarEvent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope       String
  space       String
  title       String
  description String?
  location    String?

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  timezone String // IANA, e.g. 'UTC' (TimeContextService.timezone) — never implicit

  status         String  @default("confirmed") // confirmed|tentative|cancelled
  recurrenceRule String? @map("recurrence_rule") // RFC 5545 RRULE, optional

  source   String  @default("mora") // 'mora' | 'google' | 'microsoft'
  sourceId String? @map("source_id")

  participants CalendarEventParticipant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, startsAt])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  id      String        @id @default(uuid()) @db.Uuid
  eventId String        @map("event_id") @db.Uuid
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  contactId String? @map("contact_id") @db.Uuid
  name      String?
  email     String?
  status    String? // 'accepted' | 'declined' | 'tentative' | 'pending'

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@map("calendar_event_participants")
}

// ============================================================================
// Phase F — Real-Time Voice Engine
//
// Design decisions (AGENTS Phase F §3/§21/§38):
// - Voice is a CHANNEL, not a new brain: `VoiceSession.conversationId`
//   points at the exact same `Conversation` row text chat uses — a voice
//   turn's final transcript goes through `MoraOrchestratorService.
//   handleMessage()` unchanged, and the resulting `Message` rows are
//   indistinguishable from text ones (same table, same isolation).
// - No raw audio is ever stored in PostgreSQL (§3) — only text (transcript/
//   response), timing, and metadata. Audio lives only in-memory for the
//   duration of a turn (buffered chunks → one STT call) and is discarded
//   immediately after.
// - Only 3 tables (§38: "ne crée pas 15 tables inutiles") — `VoiceSession`
//   (one per WebSocket connection's logical conversation), `VoiceTurn` (one
//   per user-utterance → Mora-response cycle, with full latency
//   breakdown), `VoiceProfile` (MoraVoiceProfile — TTS voice configuration,
//   never a secret).
// ============================================================================

model VoiceSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String @map("conversation_id") @db.Uuid

  scope String
  space String

  status String @default("created") // created|listening|user_speaking|transcribing|thinking|assistant_speaking|interrupted|paused|ended|error

  sttProvider String? @map("stt_provider") // e.g. 'openai' — resolved provider, not a secret
  ttsProvider String? @map("tts_provider")

  language String  @default("auto")
  timezone String // explicit, reuses TimeContextService default — never implicit (AGENTS Phase D correction)

  mode String @default("push_to_talk") // push_to_talk|wake_word|continuous_session

  metadata Json?

  turns VoiceTurn[]

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([conversationId])
  @@map("voice_sessions")
}

// One row per user-utterance → Mora-response cycle. Never stores raw audio
// (AGENTS §21) — `transcript`/`responseText` are the same text a text-chat
// turn would have produced, plus a full latency breakdown for observability
// (AGENTS §35).
model VoiceTurn {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  session   VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  transcript   String?
  responseText String? @map("response_text")

  interrupted Boolean @default(false)
  status      String  @default("in_progress") // in_progress|completed|interrupted|failed

  sttLatencyMs      Int? @map("stt_latency_ms")
  llmLatencyMs      Int? @map("llm_latency_ms")
  ttsFirstByteMs    Int? @map("tts_first_byte_ms")
  totalLatencyMs    Int? @map("total_latency_ms")

  pendingActionId String? @map("pending_action_id") @db.Uuid

  errorCode String? @map("error_code")

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([sessionId])
  @@map("voice_turns")
}

// MoraVoiceProfile (AGENTS §15) — TTS voice configuration only, NEVER a
// secret (the actual provider API key stays exclusively in `AiProvider`,
// resolved via VoiceProviderResolverService — see its doc comment for the
// same-OpenAI-account reuse strategy).
model VoiceProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  provider String // 'openai' today; 'elevenlabs'/'azure'/'google'/'piper' ready later
  voiceId  String @map("voice_id") // provider-specific voice identifier, e.g. 'alloy'
  language String @default("auto")
  speed    Float  @default(1.0)

  settings  Json? // provider-specific extras (style, pitch, etc.), never a secret
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("voice_profiles")
}
