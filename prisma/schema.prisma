// Mora Backend v2 — Prisma schema
// Phase A: core foundation only (User + auth). No memory/embedding models yet.
// See docs/ROADMAP.md for what pgvector-backed models arrive in Phase C.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (for migrate/studio) and
  // is passed to PrismaClient via a driver adapter at runtime (see prisma.service.ts).
  // pgvector is enabled at the database level via docker/postgres/init-pgvector.sql
  // (CREATE EXTENSION IF NOT EXISTS vector). Declaring it here keeps `prisma migrate`
  // aware of the extension so future `vector` columns (Phase C) don't require a manual
  // migration edit.
  extensions = [vector]
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// One row per issued refresh token (hashed, never stored in plaintext) so a token
// can be revoked / rotated individually instead of invalidating every session.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
