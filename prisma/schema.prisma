// Mora Backend v2 — Prisma schema
// Phase A: core foundation (User + auth).
// Phase B: router/agents/orchestrator plumbing (Conversation, Message,
// RouterDecision, AuditEntry, Setting).
// Phase C: intelligent memory (Memory, Entity, MemoryEntity,
// ConversationSummary, ProfileFact) — see docs/ARCHITECTURE.md for the
// retrieval/embedding/extraction design.
// Phase C.5: AI provider manager (AiProvider, LlmCall) — multi-LLM/embedding
// providers with encrypted API keys. See docs/ARCHITECTURE.md.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (for migrate/studio) and
  // is passed to PrismaClient via a driver adapter at runtime (see prisma.service.ts).
  // pgvector is enabled at the database level via docker/postgres/init-pgvector.sql
  // (CREATE EXTENSION IF NOT EXISTS vector). Declaring it here keeps `prisma migrate`
  // aware of the extension so future `vector` columns (Phase C) don't require a manual
  // migration edit.
  extensions = [vector]
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  refreshTokens RefreshToken[]
  conversations Conversation[]
  memories      Memory[]
  entities      Entity[]
  profileFacts  ProfileFact[]
  aiProviders   AiProvider[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// One row per issued refresh token (hashed, never stored in plaintext) so a token
// can be revoked / rotated individually instead of invalidating every session.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// route/scope/space/intent/complexity/securityLevel are kept as plain strings
// (validated in the app layer — see src/router/router.types.ts) rather than DB
// enums, so new professional "spaces" can be added without a migration.
model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  messages        Message[]
  routerDecisions RouterDecision[]
  summaries       ConversationSummary[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     MessageRole
  content  String
  scope    String // 'direct' | 'personal' | 'professional' | 'hybrid'
  space    String // 'direct' | 'personal' | 'general' | 'logistiga' | 'piston' | 'code' | 'hybrid'
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

// One row per routing decision the MoraRouterService made for a given user
// message — kept even if the message/conversation is later removed, since
// this is itself an audit trail of routing behavior.
model RouterDecision {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?      @map("message_id") @db.Uuid

  route         String
  scope         String
  space         String
  intent        String
  complexity    String
  securityLevel String @map("security_level")
  confidence    Float
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("router_decisions")
}

model AuditEntry {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid

  action   String
  scope    String?
  space    String?
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([conversationId])
  @@map("audit_entries")
}

model Setting {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================================
// Phase C — Intelligent memory
// scope/space/kind/status kept as plain strings (validated in the app layer,
// see src/memory/memory.types.ts) for the same reason as Message/RouterDecision
// in Phase B: new kinds/spaces should never require a migration.
//
// `embedding` is declared `Unsupported("vector")` because Prisma Client has no
// native vector scalar: it is written/read exclusively through parameterized
// raw SQL (see src/memory/memory-embedding.repository.ts), never through the
// generated Prisma Client API, and is therefore invisible to `prisma.memory.*`
// calls (create/update/select simply skip it).
//
// No fixed dimension is declared on the column (per the brief: never assume
// 1536), which means an ANN index (HNSW/IVFFlat) is NOT technically
// compatible here — pgvector's own engine rejects `CREATE INDEX ... USING
// hnsw` on a dimensionless `vector` column ("column does not have
// dimensions"), confirmed against a real Postgres+pgvector instance while
// building this phase. Retrieval therefore does an exact (brute-force)
// cosine-distance scan filtered by userId/scope/space/embeddingDimensions —
// correct and fine at Phase C's data volume. Once a production embedding
// model is locked in, a follow-up migration can narrow the column to
// `vector(N)` and add the HNSW index for that fixed N.
// ============================================================================

model Memory {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String // 'personal' | 'general' | 'logistiga' | 'piston' | 'code'
  kind  String // fact|preference|person|company|decision|procedure|event|project|habit

  content    String
  importance Float  @default(0.5)
  confidence Float  @default(0.5)

  source   String // 'manual' | 'extraction'
  sourceId String? @map("source_id") @db.Uuid // e.g. the message this was extracted from

  status     String    @default("active") // active|pending|archived|superseded
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  lastAccessedAt DateTime? @map("last_accessed_at")
  accessCount    Int       @default(0) @map("access_count")

  supersededById String?  @unique @map("superseded_by_id") @db.Uuid
  supersededBy   Memory?  @relation("MemorySupersession", fields: [supersededById], references: [id])
  supersedes     Memory?  @relation("MemorySupersession")

  embedding           Unsupported("vector")?
  embeddingModel       String? @map("embedding_model")
  embeddingDimensions  Int?    @map("embedding_dimensions")

  metadata Json?

  memoryEntities MemoryEntity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@index([userId, status, kind])
  @@map("memories")
}

model Entity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String // 'personal' | 'professional'
  space String
  type  String // person|company|client|project|place|equipment|object
  name  String

  aliases  String[] @default([])
  metadata Json?

  memoryEntities MemoryEntity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Cheap dedup: same user+scope+space+type+name is the same entity.
  @@unique([userId, scope, space, type, name])
  @@index([userId, scope, space])
  @@map("entities")
}

model MemoryEntity {
  id String @id @default(uuid()) @db.Uuid

  memoryId String @map("memory_id") @db.Uuid
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  role String? // e.g. 'subject' | 'mentioned'

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([memoryId, entityId])
  @@index([entityId])
  @@map("memory_entities")
}

// One row per (conversation, scope, space) — a conversation can carry both
// personal and professional messages over time (Phase B), so its summary
// must stay split the same way memory/context retrieval does, or a
// personal-scope summary could leak professional content into an agent's
// context and vice versa.
model ConversationSummary {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid

  scope String
  space String

  summary          String
  fromMessageId    String? @map("from_message_id") @db.Uuid
  toMessageId      String? @map("to_message_id") @db.Uuid
  messageCount     Int     @default(0) @map("message_count")
  approxTokenCount Int     @default(0) @map("approx_token_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([conversationId, scope, space])
  @@index([userId])
  @@map("conversation_summaries")
}

model ProfileFact {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String
  space String
  key   String
  value String

  confidence Float  @default(0.5)
  source     String

  status     String    @default("active") // active|archived|superseded
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  supersededById String?      @unique @map("superseded_by_id") @db.Uuid
  supersededBy   ProfileFact? @relation("ProfileFactSupersession", fields: [supersededById], references: [id])
  supersedes     ProfileFact? @relation("ProfileFactSupersession")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, scope, space, status])
  @@map("profile_facts")
}

// ============================================================================
// Phase C.5 — AI Provider Manager
// `provider` and `kind` are free strings, not enums, so new providers
// (Anthropic, Gemini, Groq, ...) or usage kinds (vision, stt, tts, ...) never
// need a migration — validated in the app layer (see src/ai-providers/).
//
// The API key is never stored in plaintext: `apiKeyEncrypted`/`apiKeyIv`/
// `apiKeyAuthTag` hold an AES-256-GCM ciphertext (see SecretEncryptionService)
// and only `apiKeyHint` (last 4 chars) is safe to ever return from the API.
// ============================================================================

model AiProvider {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String // display name, e.g. "My OpenAI"
  provider String // openai | anthropic | groq | deepseek | gemini | mistral | openrouter | ollama | custom_openai_compatible | ...
  kind     String // chat | embedding | vision | stt | tts | image | avatar | ...
  baseUrl  String? @map("base_url")
  model    String

  // Encrypted secret (all three null together when the provider needs no key,
  // e.g. a local Ollama endpoint with no auth).
  apiKeyEncrypted   String? @map("api_key_encrypted")
  apiKeyIv          String? @map("api_key_iv")
  apiKeyAuthTag     String? @map("api_key_auth_tag")
  apiKeyHint        String? @map("api_key_hint") // last 4 chars only, never the full key
  encryptionVersion Int     @default(1) @map("encryption_version")

  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  // Optional scoping: a global (null/null) provider is the fallback for any
  // scope/space of this kind; a scoped one (e.g. professional/logistiga) is
  // preferred by AiModelSelectorService when it matches exactly.
  scope String?
  space String?

  capabilities Json? // e.g. { chat:true, tools:true, streaming:true, vision:true, jsonMode:true }
  settings     Json? // e.g. { maxTokens, timeoutMs, maxConcurrency }
  priority     Int   @default(0) // higher wins among otherwise-equal candidates

  lastTestedAt   DateTime? @map("last_tested_at")
  lastTestStatus String?   @map("last_test_status") // 'success' | 'failure'
  lastTestMessage String?  @map("last_test_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, isActive])
  @@map("ai_providers")
}

// One row per LLM/embedding call attempted through the provider system —
// observability only. Never stores the API key, the raw prompt, or the raw
// completion (see AiProviderService / LlmService for what's logged instead).
model LlmCall {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  providerId String? @map("provider_id") @db.Uuid

  kind  String
  model String
  route String?
  scope String?
  space String?

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  latencyMs    Int    @map("latency_ms")
  status       String // 'success' | 'error'
  errorCode    String? @map("error_code")
  costEstimate Float?  @map("cost_estimate")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([providerId])
  @@map("llm_calls")
}
